    "def show_event(flavor, i):\n",
    "    h0, h1 = HITS[flavor][i]\n",
    "    row = EV[EV[\"flavor\"] == flavor].iloc[i]\n",
    "    d0 = dom_table(h0[0], h0[1], h0[2], h0[4], h0[5])\n",
    "    kept = d0[\"q\"] >= MIN_DOM_Q\n",
    "    b = d0.loc[d0[\"q\"].idxmax()]\n",
    "    rdist = np.hypot(d0[\"x\"] - b[\"x\"], d0[\"y\"] - b[\"y\"])\n",
    "\n",
    "    fig = plt.figure(figsize=(16, 9))\n",
    "    gs = fig.add_gridspec(2, 3, height_ratios=[1.15, 1])\n",
    "    norm = LogNorm(vmin=MIN_DOM_Q, vmax=max(d0[\"q\"].max(), MIN_DOM_Q * 10))\n",
    "    ax = fig.add_subplot(gs[0, 0])\n",
    "    ax.scatter(STRING_XY[\"dom_x\"], STRING_XY[\"dom_y\"], s=5, color=GRID)\n",
    "    ax.scatter(d0.loc[~kept, \"x\"], d0.loc[~kept, \"y\"], s=18, color=\"#b5b4ae\", label=f\"removed ({(~kept).sum()})\")\n",
    "    sc = ax.scatter(d0.loc[kept, \"x\"], d0.loc[kept, \"y\"], s=40, c=d0.loc[kept, \"q\"], cmap=SEQ, norm=norm,\n",
    "                    edgecolors=INK_2, linewidths=0.4, label=f\"kept ({kept.sum()})\")\n",
    "    ax.set_aspect(\"equal\"); ax.set_xlabel(\"x [m]\"); ax.set_ylabel(\"y [m]\"); ax.legend(loc=\"upper left\", fontsize=8)\n",
    "    ax.set_title(\"top view\", loc=\"left\")\n",
    "    ax = fig.add_subplot(gs[0, 1])\n",
    "    ax.scatter(rdist[~kept], d0.loc[~kept, \"z\"], s=18, color=\"#b5b4ae\")\n",
    "    ax.scatter(rdist[kept], d0.loc[kept, \"z\"], s=40, c=d0.loc[kept, \"q\"], cmap=SEQ, norm=norm,\n",
    "               edgecolors=INK_2, linewidths=0.4)\n",
    "    ax.set_xlabel(\"horizontal distance from brightest string [m]\"); ax.set_ylabel(\"z [m]\")\n",
    "    ax.set_title(\"side view\", loc=\"left\")\n",
    "    fig.colorbar(sc, ax=ax, label=\"DOM charge [PE]\")\n",
    "    ax = fig.add_subplot(gs[0, 2]); ax.axis(\"off\")\n",
    "    ax.text(0, 0.9, (f\"{flavor} event {row['event_no']}\\n\"\n",
    "                     f\"true cos zenith {row['coszen']:+.2f}, log10 E {row['log_e']:.2f}\\n\\n\"\n",
    "                     f\"DOMs   {row['doms_before']} -> {row['doms_after']}\\n\"\n",
    "                     f\"hits   {row['hits_before']} -> {row['hits_after']}\\n\"\n",
    "                     f\"charge {row['q_before']:.0f} -> {row['q_after']:.0f} PE\\n\"\n",
    "                     f\"strings {row['strings_before']} -> {row['strings_after']}\\n\"\n",
    "                     f\"valid after cut: {row['valid_after']}\"), va=\"top\", family=\"monospace\", fontsize=11)\n",
    "\n",
    "    extent = [td.IMG_T_LO, td.IMG_T_HI, td.IMG_N_SIDE + 0.5, -td.IMG_N_SIDE - 0.5]\n",
    "    for c, (h, tag) in enumerate([(h0, \"without cut\"), (h1, f\"with cut (DOM ≥ {MIN_DOM_Q:g} PE)\")]):\n",
    "        if len(h[3]) == 0:\n",
    "            continue\n",
    "        img, _ = td.brightest_string_image(h[0], h[1], h[2], h[3], h[4])\n",
    "        ax = fig.add_subplot(gs[1, c])\n",
    "        both = np.concatenate([img[0], np.full((1, img.shape[2]), np.nan), img[1]])\n",
    "        ax.imshow(np.ma.masked_invalid(np.ma.masked_less_equal(both, 0)), aspect=\"auto\", cmap=SEQ, vmin=0,\n",
    "                  vmax=img.max(), interpolation=\"nearest\",\n",
    "                  extent=[td.IMG_T_LO, td.IMG_T_HI, 2 * td.IMG_N_ROWS + 0.5, -0.5])\n",
    "        ax.set_yticks([td.IMG_N_SIDE, td.IMG_N_ROWS + 1 + td.IMG_N_SIDE], [\"ch 0\\n(brightest)\", \"ch 1\\n(neighbour)\"])\n",
    "        ax.grid(False); ax.set_xlabel(\"time since brightest DOM's first pulse [ns]\")\n",
    "        ax.set_title(f\"brightest-string image, {tag}\", loc=\"left\")\n",
    "    fig.tight_layout(); plt.show()\n",
    "\n",
