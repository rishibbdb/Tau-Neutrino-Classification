    "# Per-DOM charge cut: check before training\n",
    "\n",
    "Cut: in each event, sum the charge per DOM (after the 0.1 PE pulse threshold and 1500 ns window) and **remove every DOM whose\n",
    "total is below `MIN_DOM_Q` PE** (all of its pulses). Implemented in `trainer.preprocess_event_hits(..., min_dom_charge=...)`,\n",
    "which is called here directly, so this checks exactly what training will use (`train.py --min_dom_charge 10`).\n",
    "\n",
    "Everything downstream sees only the surviving DOMs: the DOM graph (nodes, k-NN edges), the pulse encoder, the PCA/validity cut\n",
    "(≥ 4 hits on ≥ 2 strings) and the brightest-string image.\n",
    "\n",
    "Sections: 1 setup → 2 load (with / without cut) → 3 what is removed → 4 event survival (and whether it depends on flavour,\n",
    "direction, energy) → 5 effect on the k-NN graph → 6 event displays."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "cell-1",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "N_THREADS = 8   # dev nodes kill processes over their CPU-time limit\n",
    "for _v in (\"OMP_NUM_THREADS\", \"OPENBLAS_NUM_THREADS\", \"MKL_NUM_THREADS\"):\n",
    "    os.environ.setdefault(_v, str(N_THREADS))\n",
    "\n",
    "import sqlite3\n",
    "import sys\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from IPython.display import display\n",
    "from matplotlib.colors import LinearSegmentedColormap, LogNorm\n",
    "from scipy.spatial import cKDTree\n",
    "\n",
    "ANA = \"/mnt/scratch/baburish/doublepulse/gnn/Analysis\"\n",
    "sys.path.insert(0, ANA)\n",
    "import trainer_domenc as td\n",
    "from trainer import build_geo_dict_kdtree, preprocess_event_hits\n",
    "\n",
    "DBS = {\"nutau\": f\"{ANA}/data/combined_nutau_5TeV_40k.db\", \"nue\": f\"{ANA}/data/combined_nue_5TeV_40k.db\"}\n",
    "N_PER_FLAVOR = 100\n",
    "SEED = 5\n",
    "CHARGE_THRESHOLD = 1   # train.py default (per pulse)\n",
    "MIN_DOM_Q = 20.0         # the cut under test (per DOM, PE)\n",
    "K_EDGES = 8              # trainer k-NN"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "cell-2",
   "metadata": {},
   "outputs": [],
   "source": [
    "SURFACE, INK, INK_2, GRID = \"#fcfcfb\", \"#0b0b0b\", \"#52514e\", \"#e4e3df\"\n",
    "COL = {\"nutau\": \"#2a78d6\", \"nue\": \"#eb6834\"}\n",
    "SEQ = LinearSegmentedColormap.from_list(\"seq_blue\", [\"#cde2fb\", \"#86b6ef\", \"#3987e5\", \"#1c5cab\", \"#0d366b\"])\n",
    "SEQ.set_bad(SURFACE)\n",
    "plt.rcParams.update({\n",
    "    \"figure.facecolor\": SURFACE, \"axes.facecolor\": SURFACE,\n",
    "    \"text.color\": INK, \"axes.labelcolor\": INK, \"axes.edgecolor\": INK_2,\n",
    "    \"xtick.color\": INK_2, \"ytick.color\": INK_2,\n",
    "    \"axes.grid\": True, \"grid.color\": GRID, \"grid.linewidth\": 0.8,\n",
    "    \"axes.spines.top\": False, \"axes.spines.right\": False,\n",
    "    \"lines.linewidth\": 2, \"font.size\": 10, \"legend.frameon\": False,\n",
    "})"
   ]
  },
  {
