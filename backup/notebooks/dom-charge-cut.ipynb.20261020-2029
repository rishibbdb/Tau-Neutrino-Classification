   "source": [
    "## 1–2. Load random events; preprocess without and with the cut"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "cell-4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "nutau: 100 events\n",
      "nue: 100 events\n"
     ]
    }
   ],
   "source": [
    "geo = pd.read_csv(f\"{ANA}/geometry_clean.csv\")\n",
    "kd_tree, sid_geo = build_geo_dict_kdtree(geo)\n",
    "td.set_geometry(kd_tree, sid_geo)\n",
    "STRING_XY = geo.groupby(\"string\")[[\"dom_x\", \"dom_y\"]].first()\n",
    "\n",
    "\n",
    "class SerialKD:\n",
    "    \"\"\"trainer.map_pulses_to_strings queries with workers=-1 (all cores, per event); same query, one thread.\"\"\"\n",
    "    def __init__(self, tree):\n",
    "        self.tree = tree\n",
    "\n",
    "    def query(self, pts, workers=1, **kw):\n",
    "        return self.tree.query(pts, workers=1, **kw)\n",
    "\n",
    "\n",
    "KD = SerialKD(kd_tree)\n",
    "\n",
    "\n",
    "def dom_table(x, y, z, q, sid):\n",
    "    \"\"\"Per-DOM (string, z) summary: position, string, total charge.\"\"\"\n",
    "    if len(q) == 0:\n",
    "        return pd.DataFrame(columns=[\"string\", \"x\", \"y\", \"z\", \"q\"])\n",
    "    df = pd.DataFrame({\"string\": sid, \"x\": x, \"y\": y, \"z\": z, \"q\": q})\n",
    "    return df.groupby([\"string\", \"z\"], as_index=False).agg(x=(\"x\", \"first\"), y=(\"y\", \"first\"), q=(\"q\", \"sum\"))\n",
    "\n",
    "\n",
    "def knn_stats(doms):\n",
    "    \"\"\"Same-string fraction of k-NN edges and #cross-string edges at the brightest DOM.\"\"\"\n",
    "    n = len(doms)\n",
    "    if n < 2:\n",
    "        return np.nan, np.nan\n",
    "    pos = doms[[\"x\", \"y\", \"z\"]].to_numpy()\n",
    "    k = min(K_EDGES, n - 1)\n",
    "    _, nb = cKDTree(pos).query(pos, k=k + 1)\n",
    "    src, dst = np.repeat(np.arange(n), k), nb[:, 1:].ravel()\n",
    "    s = doms[\"string\"].to_numpy()\n",
    "    b = int(np.argmax(doms[\"q\"].to_numpy()))\n",
    "    touch = (src == b) | (dst == b)\n",
    "    return float(np.mean(s[src] == s[dst])), int(np.sum(touch & (s[src] != s[dst])))\n",
    "\n",
    "\n",
    "def valid(t, sid):\n",
    "    return len(t) >= 4 and len(np.unique(sid)) >= 2    # training validity cut\n",
    "\n",
    "\n",
    "def load_flavor(flavor, n, seed=SEED):\n",
    "    con = sqlite3.connect(f\"file:{DBS[flavor]}?mode=ro\", uri=True)\n",
    "    info = pd.read_sql_query(\"SELECT event_no, zenith, primary_energy FROM truth\", con).set_index(\"event_no\")\n",
    "    pick = np.sort(np.random.default_rng(seed).choice(info.index.to_numpy(), min(n, len(info)), replace=False))\n",
    "    con.execute(\"CREATE TEMP TABLE pick(event_no INTEGER PRIMARY KEY)\")\n",
    "    con.executemany(\"INSERT INTO pick VALUES (?)\", [(int(e),) for e in pick])\n",
    "    p = pd.read_sql_query(\"SELECT event_no, dom_x, dom_y, dom_z, dom_time, charge FROM CleanedROIPulses \"\n",
    "                          \"WHERE event_no IN (SELECT event_no FROM temp.pick) ORDER BY event_no\", con)\n",
    "    con.close()\n",
    "\n",
    "    arr = p.to_numpy(float)\n",
    "    ev_ids, starts = np.unique(arr[:, 0], return_index=True)\n",
    "    bounds = np.r_[starts, len(arr)]\n",
    "    rows, all_doms, events = [], [], []\n",
    "    for i, ev_no in enumerate(ev_ids):\n",
    "        raw = arr[bounds[i]:bounds[i + 1]]\n",
    "        h0 = preprocess_event_hits(raw, KD, sid_geo, charge_threshold=CHARGE_THRESHOLD)\n",
    "        h1 = preprocess_event_hits(raw, KD, sid_geo, charge_threshold=CHARGE_THRESHOLD, min_dom_charge=MIN_DOM_Q)\n",
    "        d0 = dom_table(h0[0], h0[1], h0[2], h0[4], h0[5])\n",
    "        d1 = dom_table(h1[0], h1[1], h1[2], h1[4], h1[5])\n",
    "        same0, cross0 = knn_stats(d0)\n",
    "        same1, cross1 = knn_stats(d1)\n",
    "        inf = info.loc[int(ev_no)]\n",
    "        rows.append(dict(\n",
    "            event_no=int(ev_no), flavor=flavor, coszen=np.cos(inf[\"zenith\"]), log_e=np.log10(inf[\"primary_energy\"]),\n",
    "            doms_before=len(d0), doms_after=len(d1), hits_before=len(h0[3]), hits_after=len(h1[3]),\n",
    "            q_before=h0[4].sum(), q_after=h1[4].sum(),\n",
    "            strings_before=d0[\"string\"].nunique(), strings_after=d1[\"string\"].nunique(),\n",
    "            valid_before=valid(h0[3], h0[5]), valid_after=valid(h1[3], h1[5]),\n",
    "            brightest_same=(len(d1) > 0 and d0.loc[d0[\"q\"].idxmax(), [\"string\", \"z\"]].tolist()\n",
    "                            == d1.loc[d1[\"q\"].idxmax(), [\"string\", \"z\"]].tolist()),\n",
    "            same_string_frac_before=same0, same_string_frac_after=same1,\n",
    "            bright_cross_edges_before=cross0, bright_cross_edges_after=cross1))\n",
    "        all_doms.append(d0.assign(flavor=flavor, kept=d0[\"q\"] >= MIN_DOM_Q))\n",
    "        events.append((h0, h1))\n",
    "    print(f\"{flavor}: {len(rows)} events\")\n",
    "    return pd.DataFrame(rows), pd.concat(all_doms, ignore_index=True), events\n",
    "\n",
    "\n",
    "LOADED = {fl: load_flavor(fl, N_PER_FLAVOR) for fl in DBS}\n",
    "EV = pd.concat([v[0] for v in LOADED.values()], ignore_index=True)\n",
    "DOMS = pd.concat([v[1] for v in LOADED.values()], ignore_index=True)\n",
    "HITS = {fl: v[2] for fl, v in LOADED.items()}"
   ]
  },
